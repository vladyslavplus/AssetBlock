{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchEvaluationDatasetV1",
  "type": "object",
  "required": ["version", "provenance", "documents", "queries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "provenance": {
      "type": "string",
      "const": "synthetic-and-reviewed"
    },
    "documents": {
      "type": "array",
      "minItems": 60,
      "items": {
        "type": "object",
        "required": ["key", "title", "description", "category", "tags"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^asset-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 90,
      "items": {
        "type": "object",
        "required": ["id", "language", "kind", "text", "judgments"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "enum": ["uk", "en", "technical", "mixed"]
          },
          "kind": {
            "type": "string",
            "enum": ["natural", "keyword", "typo", "cross-language"]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "judgments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["documentKey", "relevance"],
              "additionalProperties": false,
              "properties": {
                "documentKey": {
                  "type": "string"
                },
                "relevance": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            }
          }
        }
      }
    }
  }
}
