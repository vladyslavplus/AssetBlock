{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchEvaluationHumanQrelsV1",
  "type": "object",
  "required": ["version", "provenance", "adjudicationDate", "adjudicationVersion", "queries"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "provenance": {
      "type": "string",
      "const": "human-adjudicated"
    },
    "adjudicationDate": {
      "type": "string"
    },
    "adjudicationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["queryId", "judgments"],
        "additionalProperties": false,
        "properties": {
          "queryId": {
            "type": "string",
            "minLength": 1
          },
          "judgments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["documentKey", "relevance"],
              "additionalProperties": false,
              "properties": {
                "documentKey": {
                  "type": "string"
                },
                "relevance": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            }
          }
        }
      }
    }
  }
}
