# Pinned ClamAV 1.4.6 scan limits for the official clamav/clamav image.
# docker-compose.yml loads this file via env_file; do not duplicate these keys elsewhere.
# Cover FileUpload.MaxFileBytes (250 MiB) with headroom for INSTREAM framing.
CLAMD_CONF_StreamMaxLength=280M
# Cover ArchiveInspection.MaxEntryExpandedBytes (500 MiB).
CLAMD_CONF_MaxFileSize=550M
# Cover ArchiveInspection.MaxTotalExpandedBytes (1 GiB).
CLAMD_CONF_MaxScanSize=1100M
CLAMD_CONF_MaxFiles=10000
CLAMD_CONF_MaxRecursion=20
# Fail closed when a scan hits the limits above instead of returning OK.
CLAMD_CONF_AlertExceedsMax=yes
# Nested archives are scanned by clamd, not ArchiveSafetyInspector.
# Application ClamAv:DaemonMaxStreamBytes must match StreamMaxLength when non-zero.
