# Copy to .env and adjust if needed. docker-compose uses these; defaults work for local dev.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=assetblock
POSTGRES_PORT=5432

# SeaweedFS (default local S3-compatible storage; weed mini)
AWS_ACCESS_KEY_ID=assetblock
AWS_SECRET_ACCESS_KEY=dev_seaweedfs_secret
S3_BUCKET=assets
SEAWEEDFS_S3_PORT=8333

# MinIO (compatibility profile: docker compose --profile minio up -d)
MINIO_ROOT_USER=assetblock
MINIO_ROOT_PASSWORD=dev_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PORT=6379

# Mailpit (local SMTP inbox only; bind to loopback)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# DataProtection:KeysPath is NOT configured here.
# It is a server-side filesystem path set in appsettings.Development.json or .NET User Secrets.
# Leaf directory must be dedicated (dataprotection-keys / assetblock-dataprotection-keys*).
# Production on Linux/containers: DataProtection:ProtectionMode=Certificate|Kms (fail-fast otherwise).
# See asblock-backend/README.md.

# Observability
# Observability__Enabled=true
# Observability__OtlpEndpoint=http://127.0.0.1:4317

# AI (never commit real keys). Local model ids belong in appsettings.Development.json; deployment uses standard .NET configuration.
# Ai__Enabled=false
# Ai__Provider=OpenRouter
# Ai__PromptPolicyVersion=listing-copilot-v1
# Ai__OpenRouter__ApiKey=
# Ai__OpenRouter__Models__0=
# Ai__OpenRouter__Models__1=
# Ai__Ollama__BaseUrl=http://127.0.0.1:11434
# Ai__Ollama__Model=
# Ai__Ollama__Digest=
