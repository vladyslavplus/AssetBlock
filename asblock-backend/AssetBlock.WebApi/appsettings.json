{
  "ConnectionStrings": {
    "DefaultConnection": "<default-connection-string>",
    "Redis": "<default-redis-connection-string>"
  },
  "Database": {
    "AutoMigrate": false,
    "EnsureCreated": false,
    "SeedDemoAssets": false
  },
  "Jwt": {
    "Issuer": "<AssetBlock>",
    "Audience": "<AssetBlock.Api>",
    "Key": "<dev-secret-key-min-32-characters-long-for-hmac>",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "Provider": "SeaweedFs"
  },
  "SeaweedFs": {
    "Endpoint": "<seaweedfs-endpoint>:8333",
    "Bucket": "<bucket-name>",
    "AccessKey": "<seaweedfs-access-key>",
    "SecretKey": "<seaweedfs-secret-key>",
    "UseSsl": true
  },
  "Minio": {
    "Endpoint": "<minio-endpoint>:9000",
    "Bucket": "<bucket-name>",
    "AccessKey": "<minio-access-key>",
    "SecretKey": "<minio-secret-key>",
    "UseSsl": true
  },
  "Encryption": {
    "KeyBase64": "<base64-encoded-encryption-key>"
  },
  "Stripe": {
    "SecretKey": "<stripe-secret-key>",
    "WebhookSecret": "<stripe-webhook-secret>",
    "DefaultSuccessUrl": "<default-success-url>",
    "DefaultCancelUrl": "<default-cancel-url>"
  },
  "FileUpload": {
    "MaxFileBytes": 262144000,
    "AllowedExtensions": [ ".zip", ".tar", ".tar.gz", ".tgz" ]
  },
  "Email": {
    "Provider": "Smtp",
    "FromName": "<AssetBlock>",
    "FromAddress": "<noreply@example.com>",
    "PublicAppBaseUrl": "<public-app-base-url>",
    "MessageIdDomain": "<message-id-domain>",
    "Smtp": {
      "Host": "<smtp-host>",
      "Port": 1025,
      "Security": "NONE",
      "Username": "",
      "Password": "",
      "TimeoutSeconds": 30
    }
  },
  "DataProtection": {
    "KeysPath": "<dataprotection-keys-path>",
    "ProtectionMode": "",
    "CertificatePath": "",
    "CertificatePassword": "",
    "CertificateThumbprint": "",
    "KmsKeyId": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment"
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AnalyticsRateLimiting": {
    "BffSigningSecret": ""
  },
  "AnalyticsAggregation": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "RetentionBatchSize": 10000,
    "MaxRetentionBatchesPerRun": 50,
    "CommandTimeoutSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "AssetBlock.WebApi",
    "OtlpEndpoint": "http://127.0.0.1:4317",
    "ExportTraces": true,
    "ExportMetrics": true,
    "ExportLogs": true,
    "TraceSampleRatio": 1.0
  },
  "AssetProcessing": {
    "Enabled": false,
    "PollInterval": "00:00:10",
    "BatchSize": 10,
    "Concurrency": 10,
    "LeaseDuration": "00:05:00",
    "OperationTimeout": "00:04:00",
    "MaxAttempts": 3,
    "InitialRetryDelay": "00:00:30",
    "MaxRetryDelay": "01:00:00"
  },
  "ClamAv": {
    "Enabled": false,
    "Host": "127.0.0.1",
    "Port": 3310,
    "ConnectTimeoutMs": 5000,
    "ReadTimeoutMs": 30000,
    "WriteTimeoutMs": 30000,
    "MaxStreamBytes": 293601280,
    "DaemonMaxStreamBytes": 293601280,
    "MaxSignatureAge": "3.00:00:00",
    "MaxResponseBytes": 4096
  },
  "Ai": {
    "Enabled": false,
    "Provider": "OpenRouter",
    "PromptPolicyVersion": "listing-copilot-v1",
    "OpenRouter": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "ApiKey": "",
      "Models": [],
      "Timeout": "00:01:00",
      "MaxInputChars": 12000,
      "MaxOutputTokens": 1000,
      "MaxRetryAfter": "01:00:00",
      "SiteUrl": "",
      "AppName": "AssetBlock",
      "ZeroDataRetention": false
    },
    "Ollama": {
      "BaseUrl": "http://127.0.0.1:11434",
      "Model": "",
      "Digest": "",
      "Timeout": "00:02:00",
      "MaxInputChars": 12000,
      "MaxOutputTokens": 1000
    }
  },
  "ArchiveInspection": {
    "MaxEntries": 10000,
    "MaxTotalExpandedBytes": 1073741824,
    "MaxEntryExpandedBytes": 524288000,
    "MaxCompressionRatio": 100.0,
    "MaxPathLength": 1024,
    "MaxPathDepth": 32,
    "MaxReadmeBytes": 16384,
    "MaxManifestFiles": 8,
    "MaxManifestBytes": 16384
  },
  "AllowedHosts": "*"
}
